# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# wrangler's local state and build cache
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents the required vars.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Photography lives in the Cloudflare R2 bucket, not the repo.
# Web derivatives are served from there (see src/lib/assetUrl.ts); the camera
# originals are archived outside version control. `scripts/gen-photography.py`
# rebuilds the derivatives from originals if they are restored locally.
/public/assets/photography/
/public/assets/photography-web/

# Font source downloads. The three woff2 faces the site actually serves are
# committed under src/app/fonts/, where next/font fingerprints and self-hosts
# them. This holds the rest of the vendor download — desktop OTFs, the full
# WOFF/WOFF2 set, specimen and EULA — which is trial-licensed and must not be
# web-served, so it is kept out of the repo and out of /public.
/design/fonts/

# Copy decks and other working documents.
*.docx
