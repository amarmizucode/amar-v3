# Production build defaults, committed so hosted builds (Cloudflare Workers
# Builds clones the repo, so it never sees a local .env) have them too.
# Public values only: anything here is inlined into the shipped pages.

# The R2 bucket the photography is served from. assetUrl() rewrites every
# photography path to it at build time, and the build refuses to run without
# it, since the deploy does not upload those files (see wrangler.toml).
NEXT_PUBLIC_IMAGE_BASE_URL=https://pub-17133ca67c7f4cf181068bb3821ebb92.r2.dev

# The site's public origin, no trailing slash — used for canonical URLs, the
# sitemap, robots.txt and social-share previews (see src/lib/site.ts). Leave
# unset until the domain is final; those features stay off until then.
# NEXT_PUBLIC_SITE_URL=https://example.com
