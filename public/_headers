# Cloudflare Workers static-asset headers (read by the asset server, see
# https://developers.cloudflare.com/workers/static-assets/headers/).

# Build output under _next/static is content-hashed: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images and other files in public/ keep their names across deploys, so they
# get a day in the browser and revalidate after.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
