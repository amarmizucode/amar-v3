# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Where the browser loads photography from.
#
# Unset: images are served from `public/` (plain `next dev`, no R2 needed).
# Set:   prefixed onto every manifest path, so the site loads from the bucket.
#
# Use the bucket's public r2.dev URL, or a custom domain mapped to it. No
# trailing slash. This is a NEXT_PUBLIC_ var, so it is inlined at build time —
# changing it needs a rebuild, not just a restart.
#
# NEXT_PUBLIC_IMAGE_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# ---------------------------------------------------------------------------
NEXT_PUBLIC_IMAGE_BASE_URL=

# ---------------------------------------------------------------------------
# Upload credentials, read only by `scripts/upload-r2.sh`. Never sent to the
# browser — keep them out of any NEXT_PUBLIC_ name.
#
# Account ID:  Cloudflare dashboard -> R2 -> the hex string in the endpoint URL
# Access keys: R2 -> Manage R2 API Tokens -> Create token, "Object Read & Write"
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
